{
  "name": "plantilla-backend",
  "version": "2.0.0",
  "description": "Backend base para crear nuevos programas con Express y Prisma",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:purge:all": "prisma db execute --file prisma/purge-all.sql --schema prisma/schema.prisma",
    "test": "node -e \"console.log('No hay tests automatizados todavia')\""
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "keywords": [
    "plantilla",
    "prisma",
    "express",
    "postgresql"
  ],
  "author": "jhon sebastian diaz villa",
  "license": "UNLICENSED",
  "dependencies": {
    "@prisma/client": "6.12.0",
    "@types/nodemailer": "^8.0.1",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^8.0.11",
    "pg": "^8.11.5",
    "qrcode": "^1.5.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.5.0",
    "@types/qrcode": "^1.5.6",
    "prisma": "6.12.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  }
}
