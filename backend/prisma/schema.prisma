generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
  PENDING
}

enum UserPosition {
  DIRECTIVO
  PROFESOR
  REPRESENTANTE
  ESTUDIANTE
}

enum RoleCode {
  SUPER_ADMIN
  ADMIN
  COORDINADOR
  JURADO
  PONENTE
  LOGISTICA
  PARTICIPANTE
}

enum EventType {
  GENERAL
  ACADEMIC
  TALK
  WORKSHOP
  COMPETITION
  TOURNAMENT
  HACKATHON
  CEREMONY
  OTHER
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  FINISHED
}

enum EventModality {
  PRESENTIAL
  HYBRID
  VIRTUAL
}

enum AttendanceMethod {
  QR
  MANUAL
  TEMPORARY_CODE
}

enum AttendanceStatus {
  REGISTERED
  CHECKED_IN
  CANCELLED
}

enum AttendeeCategory {
  ESTUDIANTE
  PROFESOR
  ADMINISTRATIVO
  GRADUADO
  OTRO
}

enum Sport {
  FUTBOL
  BALONCESTO
  VIDEOJUEGOS
  PING_PONG
  AJEDREZ
  ROBOTICA
  VOLEIBOL
  MARATON_PROGRAMACION
  CAPTURA_BANDERA
}

enum CompetitionMode {
  TEAM
  INDIVIDUAL
}

enum VideoGameTitle {
  FIFA
  CALL_OF_DUTY
}

enum TournamentRulePreset {
  FOOTBALL
  BASKETBALL
  VIDEO_GAME
  TABLE_TENNIS
  CHESS
  ROBOTICS_BATTLE
  CUSTOM
}

enum TournamentFormat {
  GROUPS
  KNOCKOUT
  ROUND_ROBIN
  MIXED
}

enum TournamentStatus {
  DRAFT
  REGISTRATION_OPEN
  IN_PROGRESS
  FINISHED
  CANCELLED
}

enum TournamentPhase {
  FASE_GRUPOS
  OCTAVOS
  CUARTOS
  SEMIFINAL
  FINAL
}

enum MatchStatus {
  SCHEDULED
  LIVE
  FINISHED
  CANCELLED
}

enum HackathonStatus {
  DRAFT
  REGISTRATION_OPEN
  IN_PROGRESS
  EVALUATION
  FINISHED
  CANCELLED
}

enum DeliverableType {
  PDF
  ZIP
  GITHUB_URL
  VIDEO_URL
  PRESENTATION
  OTHER
}

enum EvaluationStatus {
  DRAFT
  SUBMITTED
  INVALIDATED
}

enum NotificationChannel {
  EMAIL
  PUSH
  WEBSOCKET
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  READ
}

enum AuditAction {
  LOGIN
  LOGOUT
  CREATE
  UPDATE
  DELETE
  EVALUATE
  MATCH_CREATE
  MATCH_UPDATE
  ADMIN_CHANGE
}

model User {
  id              String     @id @default(uuid()) @db.Uuid
  name            String
  email           String     @unique
  position        UserPosition @default(ESTUDIANTE)
  phone           String?
  passwordHash    String?    @map("password_hash")
  programId       String?    @map("program_id") @db.Uuid
  semester        Int?
  universityCode  String?    @unique @map("university_code")
  photoUrl        String?    @map("photo_url")
  status          UserStatus @default(PENDING)
  emailVerifiedAt DateTime?  @map("email_verified_at")
  lastLoginAt     DateTime?  @map("last_login_at")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")
  deletedAt       DateTime?  @map("deleted_at")

  program                AcademicProgram?        @relation(fields: [programId], references: [id], onDelete: SetNull)
  roles                  UserRoleAssignment[]
  refreshSessions        RefreshSession[]
  speakerProfile         SpeakerProfile?
  jurorProfile           JurorProfile?
  eventResponsibilities  EventResponsible[]
  attendances            Attendance[]            @relation("AttendanceUser")
  scannedAttendances     Attendance[]            @relation("AttendanceScanner")
  teamMemberships        TeamMember[]
  captainTeams           Team[]                  @relation("TeamCaptain")
  tournamentParticipants TournamentParticipant[]
  hackathonMemberships   HackathonTeamMember[]
  hackathonLeaderTeams   HackathonTeam[]         @relation("HackathonTeamLeader")
  evaluations            Evaluation[]            @relation("EvaluationJudge")
  createdNotifications   Notification[]          @relation("NotificationCreator")
  receivedNotifications  NotificationRecipient[]
  auditLogs              AuditLog[]              @relation("AuditActor")

  @@index([email])
  @@index([programId])
  @@index([status])
  @@map("users")
}

model AcademicProgram {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @unique
  code      String?   @unique
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  users User[]

  @@map("academic_programs")
}

model Role {
  id          String    @id @default(uuid()) @db.Uuid
  code        RoleCode  @unique
  name        String
  description String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  users       UserRoleAssignment[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  module      String
  action      String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  roles RolePermission[]

  @@index([module, action])
  @@map("permissions")
}

model UserRoleAssignment {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([roleId])
  @@map("user_role_assignments")
}

model RolePermission {
  id           String   @id @default(uuid()) @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model RefreshSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  userAgent String?   @map("user_agent")
  ipAddress String?   @map("ip_address")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_sessions")
}

model Venue {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  location  String?
  photoUrl  String?   @map("photo_url")
  capacity  Int?
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  events      Event[]
  matches     Match[]
  tournaments Tournament[]

  @@unique([name, location])
  @@map("venues")
}

model Event {
  id          String      @id @default(uuid()) @db.Uuid
  parentId    String?     @map("parent_id") @db.Uuid
  venueId     String?     @map("venue_id") @db.Uuid
  title       String
  slug        String      @unique
  description String?
  type        EventType
  status      EventStatus @default(DRAFT)
  modality    EventModality @default(PRESENTIAL)
  streamUrl   String?     @map("stream_url")
  startsAt    DateTime    @map("starts_at")
  endsAt      DateTime    @map("ends_at")
  capacity    Int?
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  deletedAt   DateTime?   @map("deleted_at")

  parent       Event?             @relation("EventHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children     Event[]            @relation("EventHierarchy")
  venue        Venue?             @relation(fields: [venueId], references: [id], onDelete: SetNull)
  responsibles EventResponsible[]
  talk         Talk?
  attendances  Attendance[]
  tournament   Tournament?
  hackathon    HackathonEvent?

  @@index([parentId])
  @@index([venueId])
  @@index([type, status])
  @@index([startsAt, endsAt])
  @@map("events")
}

model EventResponsible {
  id        String   @id @default(uuid()) @db.Uuid
  eventId   String   @map("event_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  roleNote  String?  @map("role_note")
  createdAt DateTime @default(now()) @map("created_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId])
  @@map("event_responsibles")
}

model SpeakerProfile {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String?   @unique @map("user_id") @db.Uuid
  fullName  String    @map("full_name")
  email     String?
  company   String?
  bio       String?
  photoUrl  String?   @map("photo_url")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  user  User?  @relation(fields: [userId], references: [id], onDelete: SetNull)
  talks Talk[]

  @@map("speaker_profiles")
}

model Talk {
  id        String    @id @default(uuid()) @db.Uuid
  eventId   String    @unique @map("event_id") @db.Uuid
  speakerId String?   @map("speaker_id") @db.Uuid
  topic     String
  qrSecret  String?   @unique @map("qr_secret")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  event   Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  speaker SpeakerProfile? @relation(fields: [speakerId], references: [id], onDelete: SetNull)

  @@index([speakerId])
  @@map("talks")
}

model Attendance {
  id          String           @id @default(uuid()) @db.Uuid
  eventId     String           @map("event_id") @db.Uuid
  userId      String?          @map("user_id") @db.Uuid
  scannerId   String?          @map("scanner_id") @db.Uuid
  fullName    String?          @map("full_name")
  email       String?
  identifier  String?
  category    AttendeeCategory?
  semester    String?
  career      String?
  whatsappConsent Boolean @default(false) @map("whatsapp_consent")
  method      AttendanceMethod
  status      AttendanceStatus @default(REGISTERED)
  qrCode      String?          @unique @map("qr_code")
  tempCode    String?          @map("temp_code")
  checkedInAt DateTime?        @map("checked_in_at")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  deletedAt   DateTime?        @map("deleted_at")

  event   Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user    User? @relation("AttendanceUser", fields: [userId], references: [id], onDelete: SetNull)
  scanner User? @relation("AttendanceScanner", fields: [scannerId], references: [id], onDelete: SetNull)

  @@unique([eventId, userId])
  @@unique([eventId, identifier])
  @@index([eventId, status])
  @@index([userId])
  @@index([identifier])
  @@map("attendances")
}

model Tournament {
  id                String               @id @default(uuid()) @db.Uuid
  eventId           String?              @unique @map("event_id") @db.Uuid
  venueId           String?              @map("venue_id") @db.Uuid
  name              String
  sport             Sport
  mode              CompetitionMode      @default(TEAM)
  videoGameTitle    VideoGameTitle?      @map("video_game_title")
  rulePreset        TournamentRulePreset @default(CUSTOM) @map("rule_preset")
  format            TournamentFormat
  status            TournamentStatus     @default(DRAFT)
  description       String?
  rules             String?
  maxTeams          Int?                 @map("max_teams")
  maxMembersPerTeam Int?                 @map("max_members_per_team")
  maxParticipants   Int?                 @map("max_participants")
  pointsWin         Int                  @default(3) @map("points_win")
  pointsDraw        Int                  @default(1) @map("points_draw")
  pointsLoss        Int                  @default(0) @map("points_loss")
  allowsDraws       Boolean              @default(false) @map("allows_draws")
  restrictionGroup  String?              @map("restriction_group")
  startsAt          DateTime?            @map("starts_at")
  endsAt            DateTime?            @map("ends_at")
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")
  deletedAt         DateTime?            @map("deleted_at")

  event        Event?                  @relation(fields: [eventId], references: [id], onDelete: SetNull)
  venue        Venue?                  @relation(fields: [venueId], references: [id], onDelete: SetNull)
  groups       TournamentGroup[]
  teams        Team[]
  participants TournamentParticipant[]
  matches      Match[]
  standings    TournamentStanding[]

  @@index([sport, status])
  @@index([mode, format])
  @@index([restrictionGroup])
  @@index([venueId])
  @@map("tournaments")
}

model TournamentGroup {
  id           String    @id @default(uuid()) @db.Uuid
  tournamentId String    @map("tournament_id") @db.Uuid
  name         String
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  tournament   Tournament              @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  teams        Team[]
  participants TournamentParticipant[]
  matches      Match[]
  standings    TournamentStanding[]

  @@unique([tournamentId, name])
  @@map("tournament_groups")
}

model TournamentParticipant {
  id           String    @id @default(uuid()) @db.Uuid
  tournamentId String    @map("tournament_id") @db.Uuid
  userId       String?   @map("user_id") @db.Uuid
  groupId      String?   @map("group_id") @db.Uuid
  displayName  String    @map("display_name")
  email        String?
  identifier   String?
  semester     String?
  career       String?
  whatsappConsent Boolean @default(false) @map("whatsapp_consent")
  status       String    @default("PENDING")
  seed         Int?
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  tournament  Tournament           @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user        User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  group       TournamentGroup?     @relation(fields: [groupId], references: [id], onDelete: SetNull)
  homeMatches Match[]              @relation("HomeParticipant")
  awayMatches Match[]              @relation("AwayParticipant")
  wonMatches  Match[]              @relation("WinnerParticipant")
  standings   TournamentStanding[]

  @@unique([tournamentId, userId])
  @@unique([tournamentId, email])
  @@unique([tournamentId, identifier])
  @@index([userId])
  @@index([groupId])
  @@map("tournament_participants")
}

model Team {
  id           String    @id @default(uuid()) @db.Uuid
  tournamentId String    @map("tournament_id") @db.Uuid
  groupId      String?   @map("group_id") @db.Uuid
  captainId    String?   @map("captain_id") @db.Uuid
  name         String
  logoUrl      String?   @map("logo_url")
  status       String    @default("PENDING")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  tournament  Tournament           @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  group       TournamentGroup?     @relation(fields: [groupId], references: [id], onDelete: SetNull)
  captain     User?                @relation("TeamCaptain", fields: [captainId], references: [id], onDelete: SetNull)
  members     TeamMember[]
  homeMatches Match[]              @relation("HomeTeam")
  awayMatches Match[]              @relation("AwayTeam")
  wonMatches  Match[]              @relation("WinnerTeam")
  standings   TournamentStanding[]

  @@unique([tournamentId, name])
  @@index([groupId])
  @@index([captainId])
  @@map("teams")
}

model TeamMember {
  id         String   @id @default(uuid()) @db.Uuid
  teamId     String   @map("team_id") @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  fullName   String?  @map("full_name")
  identifier String?
  email      String?
  semester   String?
  career     String?
  whatsappConsent Boolean @default(false) @map("whatsapp_consent")
  isCaptain  Boolean  @default(false) @map("is_captain")
  createdAt  DateTime @default(now()) @map("created_at")

  team Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([teamId, userId])
  @@unique([teamId, email])
  @@unique([teamId, identifier])
  @@index([userId])
  @@map("team_members")
}

model Match {
  id                  String          @id @default(uuid()) @db.Uuid
  tournamentId        String          @map("tournament_id") @db.Uuid
  groupId             String?         @map("group_id") @db.Uuid
  venueId             String?         @map("venue_id") @db.Uuid
  homeTeamId          String?         @map("home_team_id") @db.Uuid
  awayTeamId          String?         @map("away_team_id") @db.Uuid
  winnerTeamId        String?         @map("winner_team_id") @db.Uuid
  homeParticipantId   String?         @map("home_participant_id") @db.Uuid
  awayParticipantId   String?         @map("away_participant_id") @db.Uuid
  winnerParticipantId String?         @map("winner_participant_id") @db.Uuid
  phase               TournamentPhase
  status              MatchStatus     @default(SCHEDULED)
  scheduledAt         DateTime?       @map("scheduled_at")
  scheduledEndsAt     DateTime?       @map("scheduled_ends_at")
  startedAt           DateTime?       @map("started_at")
  finishedAt          DateTime?       @map("finished_at")
  homeScore           Int             @default(0) @map("home_score")
  awayScore           Int             @default(0) @map("away_score")
  stats               Json?
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")
  deletedAt           DateTime?       @map("deleted_at")

  tournament        Tournament             @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  group             TournamentGroup?       @relation(fields: [groupId], references: [id], onDelete: SetNull)
  venue             Venue?                 @relation(fields: [venueId], references: [id], onDelete: SetNull)
  homeTeam          Team?                  @relation("HomeTeam", fields: [homeTeamId], references: [id], onDelete: SetNull)
  awayTeam          Team?                  @relation("AwayTeam", fields: [awayTeamId], references: [id], onDelete: SetNull)
  winnerTeam        Team?                  @relation("WinnerTeam", fields: [winnerTeamId], references: [id], onDelete: SetNull)
  homeParticipant   TournamentParticipant? @relation("HomeParticipant", fields: [homeParticipantId], references: [id], onDelete: SetNull)
  awayParticipant   TournamentParticipant? @relation("AwayParticipant", fields: [awayParticipantId], references: [id], onDelete: SetNull)
  winnerParticipant TournamentParticipant? @relation("WinnerParticipant", fields: [winnerParticipantId], references: [id], onDelete: SetNull)

  @@index([tournamentId, phase, status])
  @@index([scheduledAt])
  @@index([homeTeamId])
  @@index([awayTeamId])
  @@index([homeParticipantId])
  @@index([awayParticipantId])
  @@map("matches")
}

model TournamentStanding {
  id             String   @id @default(uuid()) @db.Uuid
  tournamentId   String   @map("tournament_id") @db.Uuid
  groupId        String?  @map("group_id") @db.Uuid
  teamId         String?  @map("team_id") @db.Uuid
  participantId  String?  @map("participant_id") @db.Uuid
  played         Int      @default(0)
  won            Int      @default(0)
  drawn          Int      @default(0)
  lost           Int      @default(0)
  points         Int      @default(0)
  goalsFor       Int      @default(0) @map("goals_for")
  goalsAgainst   Int      @default(0) @map("goals_against")
  goalDifference Int      @default(0) @map("goal_difference")
  rank           Int?
  qualified      Boolean  @default(false)
  updatedAt      DateTime @updatedAt @map("updated_at")

  tournament  Tournament             @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  group       TournamentGroup?       @relation(fields: [groupId], references: [id], onDelete: SetNull)
  team        Team?                  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  participant TournamentParticipant? @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, groupId, teamId])
  @@unique([tournamentId, groupId, participantId])
  @@index([teamId])
  @@index([participantId])
  @@map("tournament_standings")
}

model HackathonEvent {
  id          String          @id @default(uuid()) @db.Uuid
  eventId     String?         @unique @map("event_id") @db.Uuid
  name        String
  status      HackathonStatus @default(DRAFT)
  description String?
  startsAt    DateTime?       @map("starts_at")
  endsAt      DateTime?       @map("ends_at")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  deletedAt   DateTime?       @map("deleted_at")

  event       Event?                @relation(fields: [eventId], references: [id], onDelete: SetNull)
  challenges  HackathonChallenge[]
  teams       HackathonTeam[]
  rubricItems EvaluationCriterion[]

  @@index([status])
  @@map("hackathon_events")
}

model Company {
  id           String    @id @default(uuid()) @db.Uuid
  name         String    @unique
  contactName  String?   @map("contact_name")
  contactEmail String?   @map("contact_email")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  challenges HackathonChallenge[]

  @@map("companies")
}

model HackathonChallenge {
  id               String    @id @default(uuid()) @db.Uuid
  hackathonEventId String    @map("hackathon_event_id") @db.Uuid
  companyId        String?   @map("company_id") @db.Uuid
  title            String
  description      String
  requirements     String?
  suggestedTech    String?   @map("suggested_tech")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  hackathonEvent HackathonEvent  @relation(fields: [hackathonEventId], references: [id], onDelete: Cascade)
  company        Company?        @relation(fields: [companyId], references: [id], onDelete: SetNull)
  teams          HackathonTeam[]

  @@index([hackathonEventId])
  @@index([companyId])
  @@map("hackathon_challenges")
}

model HackathonTeam {
  id               String    @id @default(uuid()) @db.Uuid
  hackathonEventId String    @map("hackathon_event_id") @db.Uuid
  challengeId      String?   @map("challenge_id") @db.Uuid
  leaderId         String?   @map("leader_id") @db.Uuid
  name             String
  projectName      String?   @map("project_name")
  githubUrl        String?   @map("github_url")
  demoUrl          String?   @map("demo_url")
  finalScore       Decimal?  @map("final_score") @db.Decimal(6, 2)
  finalRank        Int?      @map("final_rank")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  hackathonEvent HackathonEvent         @relation(fields: [hackathonEventId], references: [id], onDelete: Cascade)
  challenge      HackathonChallenge?    @relation(fields: [challengeId], references: [id], onDelete: SetNull)
  leader         User?                  @relation("HackathonTeamLeader", fields: [leaderId], references: [id], onDelete: SetNull)
  members        HackathonTeamMember[]
  deliverables   HackathonDeliverable[]
  evaluations    Evaluation[]

  @@unique([hackathonEventId, name])
  @@index([challengeId])
  @@index([leaderId])
  @@map("hackathon_teams")
}

model HackathonTeamMember {
  id              String   @id @default(uuid()) @db.Uuid
  hackathonTeamId String   @map("hackathon_team_id") @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  isLeader        Boolean  @default(false) @map("is_leader")
  createdAt       DateTime @default(now()) @map("created_at")

  hackathonTeam HackathonTeam @relation(fields: [hackathonTeamId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([hackathonTeamId, userId])
  @@index([userId])
  @@map("hackathon_team_members")
}

model HackathonDeliverable {
  id              String          @id @default(uuid()) @db.Uuid
  hackathonTeamId String          @map("hackathon_team_id") @db.Uuid
  type            DeliverableType
  title           String
  url             String
  submittedAt     DateTime        @default(now()) @map("submitted_at")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  deletedAt       DateTime?       @map("deleted_at")

  hackathonTeam HackathonTeam @relation(fields: [hackathonTeamId], references: [id], onDelete: Cascade)

  @@index([hackathonTeamId])
  @@map("hackathon_deliverables")
}

model JurorProfile {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @unique @map("user_id") @db.Uuid
  specialty    String?
  organization String?
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("juror_profiles")
}

model EvaluationCriterion {
  id               String    @id @default(uuid()) @db.Uuid
  hackathonEventId String    @map("hackathon_event_id") @db.Uuid
  name             String
  description      String?
  weight           Decimal   @db.Decimal(5, 2)
  maxScore         Decimal   @map("max_score") @db.Decimal(6, 2)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  hackathonEvent HackathonEvent    @relation(fields: [hackathonEventId], references: [id], onDelete: Cascade)
  scores         EvaluationScore[]

  @@unique([hackathonEventId, name])
  @@map("evaluation_criteria")
}

model Evaluation {
  id              String           @id @default(uuid()) @db.Uuid
  hackathonTeamId String           @map("hackathon_team_id") @db.Uuid
  judgeId         String           @map("judge_id") @db.Uuid
  status          EvaluationStatus @default(DRAFT)
  observations    String?
  totalScore      Decimal?         @map("total_score") @db.Decimal(6, 2)
  submittedAt     DateTime?        @map("submitted_at")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  deletedAt       DateTime?        @map("deleted_at")

  hackathonTeam HackathonTeam     @relation(fields: [hackathonTeamId], references: [id], onDelete: Cascade)
  judge         User              @relation("EvaluationJudge", fields: [judgeId], references: [id], onDelete: Cascade)
  scores        EvaluationScore[]

  @@unique([hackathonTeamId, judgeId])
  @@index([judgeId])
  @@index([status])
  @@map("evaluations")
}

model EvaluationScore {
  id           String   @id @default(uuid()) @db.Uuid
  evaluationId String   @map("evaluation_id") @db.Uuid
  criterionId  String   @map("criterion_id") @db.Uuid
  score        Decimal  @db.Decimal(6, 2)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  evaluation Evaluation          @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  criterion  EvaluationCriterion @relation(fields: [criterionId], references: [id], onDelete: Cascade)

  @@unique([evaluationId, criterionId])
  @@index([criterionId])
  @@map("evaluation_scores")
}

model Notification {
  id        String              @id @default(uuid()) @db.Uuid
  creatorId String?             @map("creator_id") @db.Uuid
  channel   NotificationChannel
  status    NotificationStatus  @default(PENDING)
  title     String
  body      String
  payload   Json?
  sentAt    DateTime?           @map("sent_at")
  createdAt DateTime            @default(now()) @map("created_at")
  updatedAt DateTime            @updatedAt @map("updated_at")
  deletedAt DateTime?           @map("deleted_at")

  creator    User?                   @relation("NotificationCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  recipients NotificationRecipient[]

  @@index([channel, status])
  @@map("notifications")
}

model NotificationRecipient {
  id             String             @id @default(uuid()) @db.Uuid
  notificationId String             @map("notification_id") @db.Uuid
  userId         String             @map("user_id") @db.Uuid
  status         NotificationStatus @default(PENDING)
  readAt         DateTime?          @map("read_at")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
  @@index([userId, status])
  @@map("notification_recipients")
}

model StorageAsset {
  id        String    @id @default(uuid()) @db.Uuid
  bucket    String
  key       String
  url       String
  mimeType  String?   @map("mime_type")
  sizeBytes BigInt?   @map("size_bytes")
  ownerId   String?   @map("owner_id") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@unique([bucket, key])
  @@index([ownerId])
  @@map("storage_assets")
}

model SiteSetting {
  id               String   @id @default("public")
  brandName        String   @default("Mes de la Ingeniería") @map("brand_name")
  heroTitle        String   @default("Innovación que transforma el futuro.") @map("hero_title")
  logoUrl          String?  @map("logo_url")
  smtpEnabled      Boolean  @default(false) @map("smtp_enabled")
  smtpHost         String?  @map("smtp_host")
  smtpPort         Int?     @map("smtp_port")
  smtpSecure       Boolean  @default(false) @map("smtp_secure")
  smtpUser         String?  @map("smtp_user")
  smtpPassword     String?  @map("smtp_password")
  smtpFromName     String?  @map("smtp_from_name")
  smtpFromEmail    String?  @map("smtp_from_email")
  smtpReplyTo      String?  @map("smtp_reply_to")
  smtpBatchSize    Int      @default(40) @map("smtp_batch_size")
  smtpBatchDelayMs Int      @default(1500) @map("smtp_batch_delay_ms")
  updatedAt        DateTime @updatedAt @map("updated_at")
  createdAt        DateTime @default(now()) @map("created_at")

  @@map("site_settings")
}

model ReportExport {
  id          String    @id @default(uuid()) @db.Uuid
  type        String
  format      String
  filters     Json?
  fileUrl     String?   @map("file_url")
  generatedBy String?   @map("generated_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  @@index([type, format])
  @@map("report_exports")
}

model AuditLog {
  id        String      @id @default(uuid()) @db.Uuid
  actorId   String?     @map("actor_id") @db.Uuid
  action    AuditAction
  entity    String
  entityId  String?     @map("entity_id") @db.Uuid
  oldValues Json?       @map("old_values")
  newValues Json?       @map("new_values")
  ipAddress String?     @map("ip_address")
  userAgent String?     @map("user_agent")
  createdAt DateTime    @default(now()) @map("created_at")

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([entity, entityId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}
