# Dominio o IP publica. Para probar por IP puedes usar 10.60.15.125.
APP_DOMAIN=semana.example.com
API_DOMAIN=api.semana.example.com

# Frontend. Debe terminar en /api porque el backend monta las rutas bajo /api.
# Para probar por IP usa: http://10.60.15.125/api
FRONTEND_VITE_API_URL=http://semana.example.com/api

# PostgreSQL interno de Docker.
POSTGRES_DB=semana_ingenieria
POSTGRES_USER=semana_user
POSTGRES_PASSWORD=change-me-strong-db-password
BACKEND_DATABASE_URL=postgresql://semana_user:change-me-strong-db-password@postgres:5432/semana_ingenieria

# Backend.
BACKEND_NODE_ENV=production
BACKEND_PORT=3002
BACKEND_JWT_ACCESS_SECRET=change-me-long-random-secret
BACKEND_ACCESS_TOKEN_EXPIRES_IN=15m
BACKEND_REFRESH_TOKEN_DAYS=7

# Base de datos al iniciar el contenedor.
# RUN_MIGRATIONS=true aplica solamente migraciones versionadas en backend/prisma/migrations.
# RUN_SEED=true crea/actualiza roles, permisos, espacios base y el admin inicial.
RUN_MIGRATIONS=true
RUN_SEED=false

# Admin inicial usado por npm run db:seed cuando RUN_SEED=true.
SEED_ADMIN_EMAIL=admin@semanaingenieria.local
SEED_ADMIN_PASSWORD=change-me-admin-password
